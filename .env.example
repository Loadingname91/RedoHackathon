# Copy this file to .env.local and fill in the values. Never put real keys in THIS file (it gets committed).

# Server-only (used by Vercel functions in /api). No VITE_ prefix, so they never reach the browser.
# OpenRouteService (routing): openrouteservice.org dashboard
ORS_API_KEY=
# Claude API (announcement parsing): console.anthropic.com > API Keys
ANTHROPIC_API_KEY=

# Browser-safe (VITE_ prefix = bundled into the app).
# Supabase: Project Settings > API Keys. Use the sb_publishable_ key, never the sb_secret_ key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Admin DB connection (Supabase > Connect > Session pooler URI). Only for running supabase/schema.sql. Never in the app.
SUPABASE_DB_URL=

# Admin sync (server-only). ADMIN_SYNC_KEY = the admin key (scripts/.admin-secret.txt); CRON_SECRET = any long random string.
# Vercel sends "Authorization: Bearer $CRON_SECRET" to /api/sync on the schedule in vercel.json (daily on the Hobby plan).
ADMIN_SYNC_KEY=
CRON_SECRET=
